# Copiez ce fichier en ".env" (sans ".example") et remplissez les valeurs
# POUR TESTER EN LOCAL sur votre ordinateur (avec `npm start`).
#
# ⚠️ Sur Vercel, ce fichier .env n'est PAS utilisé (il n'est même pas envoyé,
# il est ignoré via .gitignore). Sur Vercel, vous devez saisir ces mêmes
# valeurs dans : Vercel → votre projet → Settings → Environment Variables.
# Voir la section "Déployer sur Vercel" du README pour le détail.
#
# Le fichier ".env" ne doit JAMAIS être partagé ni mis en ligne publiquement
# (il est déjà exclu via .gitignore) — il contient vos secrets.

# ---- MongoDB ----
# 1. Créez un compte gratuit sur https://www.mongodb.com/cloud/atlas/register
# 2. Créez un cluster gratuit (M0)
# 3. "Database Access" → créez un utilisateur avec mot de passe
# 4. "Network Access" → autorisez votre IP (ou 0.0.0.0/0 pour autoriser depuis
#    n'importe où, pratique le temps de déployer le site)
# 5. "Connect" → "Drivers" → copiez l'URI de connexion et remplacez
#    <password> par le mot de passe créé à l'étape 3
MONGODB_URI=mongodb+srv://utilisateur:motdepasse@votrecluster.mongodb.net/
MONGODB_DB_NAME=blesslev

# ---- Resend (envoi d'emails) ----
# 1. Créez un compte gratuit sur https://resend.com
# 2. "API Keys" → créez une clé → collez-la ci-dessous
# 3. "Domains" → ajoutez et vérifiez votre propre domaine (recommandé), ou
#    utilisez temporairement l'adresse de test fournie par Resend pour essayer
# 4. RESEND_FROM_EMAIL doit être une adresse de ce domaine vérifié
#    (ex: commandes@votredomaine.com)
# 5. MERCHANT_EMAIL est l'adresse qui recevra la notification de commande
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=commandes@votredomaine.com
MERCHANT_EMAIL=votre-adresse-perso@example.com

# ---- Connexion à l'espace commerçant (identifiant + mot de passe) ----
# ADMIN_USERNAME : choisissez librement (pas besoin d'un email, juste un identifiant)
ADMIN_USERNAME=blesslev-admin
# ADMIN_PASSWORD_HASH : ne mettez JAMAIS le mot de passe en clair ici.
# Pour générer le hash de votre mot de passe :
#   1. Dans le dossier du projet, lancez : node
#   2. Collez : require('bcryptjs').hashSync('votreMotDePasse', 10)
#   3. Copiez le résultat (commence par "$2a$" ou "$2b$") ci-dessous
ADMIN_PASSWORD_HASH=$2a$10$remplacezMoiParLeHashGenere

# JWT_SECRET : une longue chaîne aléatoire, utilisée pour signer les sessions
# de connexion admin. Générez-en une avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=remplacez-moi-par-une-longue-chaine-aleatoire

# ---- Divers ----
PORT=3000
NODE_ENV=development
